# Required
MEMFS_SYNC_URL=
MEMFS_SYNC_TOKEN=
GITHUB_TOKEN=

# Channels — at least one must be configured

# AgentMail (optional — leave blank to disable)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Signing secret returned by POST /v0/webhooks when you register the
# webhook URL. Format: whsec_<base64>. Used for Svix signature verification
# on the /agentmail/webhook route. Without this, the route stays
# unregistered and AgentMail inbound falls back to the legacy WebSocket.
AGENTMAIL_WEBHOOK_SECRET=

# Slack (optional — leave blank to disable)
SLACK_BOT_TOKEN=
# Socket Mode app-level token (xapp-...). Only needed for the legacy
# Socket Mode transport. Leave blank when using the Events API webhook
# below; the two transports are mutually exclusive on the Slack app side.
SLACK_APP_TOKEN=
# Signing Secret from the Slack app's "Basic Information" page. Required
# for the Events API webhook at /slack/webhook. When set together with
# the manifest's `event_subscriptions.request_url`, Slack delivers events
# via HTTPS instead of the Socket Mode WebSocket.
SLACK_SIGNING_SECRET=

# Linear webhooks (optional — leave blank to disable)
# Create a webhook in Linear Settings → API → Webhooks
# pointing to your server's /linear/webhook endpoint
LINEAR_WEBHOOK_SECRET=
# MEGA_LINEAR_PORT=8000

# Spool I/O substrate (experimental). When MEGA_USE_SPOOL=true the
# enabled channels run as bidirectional Spool relays + a Spool-driven
# consumer loop (see core/spool-loop.ts). Direct channel callbacks are
# disabled in this mode to avoid double-processing. Today only the
# AgentMail channel has a Spool path; Slack and Linear stay on direct
# until they're cut over.
# MEGA_USE_SPOOL=true
# MEGA_SPOOL_URL=https://spool.computer
# MEGA_DOMAIN=india-desert.exe.xyz
