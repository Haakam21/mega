# Required
MEMFS_SYNC_URL=
MEMFS_SYNC_TOKEN=
GITHUB_TOKEN=

# Channels — at least one must be configured.
#
# AgentMail is brokered by fabric (https://fabric.delivery). Mega doesn't
# receive AgentMail webhooks directly; fabric does, and forks one Spool
# thread per email thread under the parent below. Mega's discovery
# consumer tails the parent and spins one Claude session per fork.
# Slack and Linear still arrive at Mega's /slack/webhook and
# /linear/webhook directly.

# AgentMail-via-fabric (optional — leave blank to disable)
# Set this to the Spool parent thread that fabric publishes into; create
# the thread under Mega's client_id and invite fabric-prod as `writer`.
MEGA_AGENTMAIL_PARENT=

# Slack (optional — leave blank to disable)
# Bot User OAuth Token (xoxb-...). Authorizes outbound chat.postMessage,
# reactions, conversations.replies, etc.
SLACK_BOT_TOKEN=
# Signing Secret from the Slack app's "Basic Information" page. Used to
# verify the HMAC on inbound Events API deliveries.
SLACK_SIGNING_SECRET=

# Linear (optional — leave blank to disable)
# HMAC-SHA256 signing secret from the Linear webhook config.
LINEAR_WEBHOOK_SECRET=

# Spool I/O substrate (optional — Mega uses Spool as its event bus).
# MEGA_SPOOL_URL=https://spool.computer
# MEGA_DOMAIN=india-desert.exe.xyz
# MEGA_HTTP_PORT=8000
