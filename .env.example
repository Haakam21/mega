# Required
MEMFS_SYNC_URL=
MEMFS_SYNC_TOKEN=
GITHUB_TOKEN=

# Channels — at least one must be configured.
#
# AgentMail and Slack are brokered by fabric (https://fabric.delivery).
# Mega doesn't receive their webhooks directly — fabric does, and forks
# one Spool thread per email-thread / Slack-thread under the parents
# below. Mega's discovery consumer tails each parent and spins one
# agent session per fork (claude or codex — see MEGA_AGENT below).
#
# Linear still arrives at Mega's /linear/webhook directly.

# AgentMail-via-fabric (optional — leave blank to disable)
MEGA_AGENTMAIL_PARENT=

# Slack-via-fabric (optional — leave blank to disable)
MEGA_SLACK_PARENT=

# Linear (optional — leave blank to disable)
# HMAC-SHA256 signing secret from the Linear webhook config.
LINEAR_WEBHOOK_SECRET=

# Agent backend (optional). Which agent CLI the SDK spawns per turn,
# across every channel: `claude` (default) or `codex`. Unrecognized values
# fall back to claude. `MEGA_CODEX_BIN` overrides the codex binary path.
# MEGA_AGENT=claude
# MEGA_CODEX_BIN=codex
#
# Codex engine (only when MEGA_AGENT=codex): `exec` (one-shot per turn,
# default) or `steer` (long-lived codex app-server thread per fork; a mid-turn
# event steers the live turn via turn/steer instead of aborting + restarting).
# MEGA_CODEX_THREADS_PATH persists the fork→thread map for resume across
# restarts (default <repo>/.codex-threads.json).
# MEGA_CODEX_MODE=exec
# MEGA_CODEX_THREADS_PATH=.codex-threads.json

# Spool I/O substrate (optional — Mega uses Spool as its event bus).
# MEGA_SPOOL_URL=https://spool.computer
# MEGA_DOMAIN=india-desert.exe.xyz
# MEGA_HTTP_PORT=8000
