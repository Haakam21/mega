# Required
MEMFS_SYNC_URL=
MEMFS_SYNC_TOKEN=
GITHUB_TOKEN=

# Channels — at least one must be configured

# AgentMail (optional — leave blank to disable)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Slack (optional — leave blank to disable)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Linear webhooks (optional — leave blank to disable)
# Create a webhook in Linear Settings → API → Webhooks
# pointing to your server's /linear/webhook endpoint
LINEAR_WEBHOOK_SECRET=
# MEGA_LINEAR_PORT=8000
